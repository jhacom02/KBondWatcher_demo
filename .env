TARGET=25-10
CHROME_TITLE=FORESTBOND
YIELD_PREFIX=3
REQUIRED_SIDE=ANY
POLL_INTERVAL_MS=300
PROCESS_EXISTING_ON_START=true

EXCEL_WORKBOOK=sample.xlsm
EXCEL_SHEET=트레이딩
EXCEL_INPUT_CELL=D41
EXCEL_PNL_CELL=F44
EXCEL_STATUS_CELL=G2
EXCEL_LAST_QUOTE_CELL=H2
EXCEL_LAST_PNL_CELL=I2
EXCEL_LAST_ACTION_CELL=J2
PNL_THRESHOLD=1000000

KAKAO_PROCESS_NAME=kakaotalk.exe
KAKAO_WINDOW_CLASS=EVA_Window_Dblclk
KAKAO_MAIN_TITLE=카카오톡
KAKAO_ROOM_NAME=장현아
MESSAGE_TEMPLATE={instrument} {raw_token} ㅎㅈ

KAKAO_CHAT_TAB_X=0.08
KAKAO_CHAT_TAB_Y=0.15
KAKAO_INPUT_X=0.5
KAKAO_INPUT_Y=0.9

KAKAO_ROOM_WINDOW_WAIT_SECONDS=12
KAKAO_FOREGROUND_RETRY_PAUSE_SECONDS=0.1
KAKAO_WINDOW_POLL_INTERVAL_SECONDS=0.4
KAKAO_ACTIVATE_SHOW_PAUSE_SECONDS=0.15
KAKAO_AFTER_ACTIVATE_PAUSE_SECONDS=0.2
KAKAO_CHAT_TAB_PAUSE_SECONDS=0.3
KAKAO_SEARCH_OPEN_PAUSE_SECONDS=0.45
KAKAO_SEARCH_RESET_PAUSE_SECONDS=0.1
KAKAO_SEARCH_PASTE_PAUSE_SECONDS=0.7
KAKAO_ROOM_ENTER_PAUSE_SECONDS=1.1
KAKAO_INPUT_CLICK_PAUSE_SECONDS=0.2
KAKAO_PASTE_PAUSE_SECONDS=0.7
KAKAO_SEND_PAUSE_SECONDS=0.8
KAKAO_SEARCH_CLEAR_BACKSPACE_COUNT=10

STOP_FLAG_PATH=C:\temp\kbond_watcher.stop
LOG_LEVEL=INFO
LOG_PATH=logs\watcher.log
