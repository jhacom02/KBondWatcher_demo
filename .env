# =============================== Customize your own settings! ===============================

# Excel workbook path & sheet name
EXCEL_WORKBOOK=C:\mycode\KBondWatcher\data\sample.xlsm
EXCEL_SHEET=트레이딩

# Which mode to run (MODE 1: KBond/KBond, MODE 2: KBond/Notepad, MODE 3: FORESTBOND/Notepad)
MODE=2

# Which slots may be selected from D2 (19: 국고 25-5, 25: 국고 25-11, 41: 국고 25-10, 46: 국고 25-04, 56: 국고 25-08)
EXCEL_SLOT_ROWS=19,25,41,46,56

# Message template
MESSAGE_TEMPLATE={instrument} {confirm_token} ㅎㅈ

# ============================================================================================

# Excel prefix cells
EXCEL_PREFIX_3Y_CELL=B5    
EXCEL_PREFIX_10Y_CELL=B6
EXCEL_ROWS_3Y=41,46,56
EXCEL_ROWS_10Y=19,25
EXCEL_PNL_ROW_OFFSET=3

# Excel column names
EXCEL_INSTRUMENT_COL=A
EXCEL_INPUT_COL=D
EXCEL_QTY_COL=E
EXCEL_PNL_COL=F

# Excel KBondWatcher status cells
EXCEL_STATUS_CELL=F2
EXCEL_LOOKING_FOR_CELL=G2
EXCEL_LAST_QUOTE_CELL=H2
EXCEL_LAST_PNL_CELL=I2
EXCEL_LAST_ACTION_CELL=J2

# M1: KBond click location, M23: Notepad click location
SEND_INPUT_X_M1=0.825
SEND_INPUT_Y_M1=0.940
SEND_INPUT_X_M23=0.5
SEND_INPUT_Y_M23=0.5

# Process existing on start
PROCESS_EXISTING_ON_START=false

# Poll interval
POLL_INTERVAL_MS=300

# Send pause seconds
SEND_FOREGROUND_RETRY_PAUSE_SECONDS=0.1
SEND_ACTIVATE_SHOW_PAUSE_SECONDS=0.15
SEND_AFTER_ACTIVATE_PAUSE_SECONDS=0.2
SEND_INPUT_CLICK_PAUSE_SECONDS=0.2
SEND_PASTE_PAUSE_SECONDS=0.3
SEND_SEND_PAUSE_SECONDS=0.3

# Stop flag path
STOP_FLAG_PATH=C:\temp\kbond_watcher.stop

# Log level & path
LOG_LEVEL=INFO
LOG_PATH=logs\watcher.log
